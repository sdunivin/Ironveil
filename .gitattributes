# Ironveil — .gitattributes for Unreal Engine 5.8 + Blender
# Sends large binary files through Git LFS so the repository stays fast.
# Commit this file BEFORE you add any assets, or they'll go into normal Git.

# Normalize line endings for text files
* text=auto

# Unreal source and config stay as text
*.cpp text
*.h text
*.cs text
*.ini text
*.uproject text
*.uplugin text

# ---------------------------------------------------------------
# Unreal assets and maps
# ---------------------------------------------------------------
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text

# ---------------------------------------------------------------
# 3D source and exchange files (Blender, Substance, etc.)
# ---------------------------------------------------------------
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
